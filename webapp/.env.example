# Web process. Keep loopback unless WORLDCLAW_API_TOKEN is configured.
WORLDCLAW_HOST=127.0.0.1
WORLDCLAW_PORT=7865
WORLDCLAW_GPU=0
# WORLDCLAW_API_TOKEN=replace-with-a-long-random-token
WORLDCLAW_MIN_FREE_VRAM_MIB=12288

# Optional portable roots
# WORLDCLAW_ROOT=/path/to/worldclaw-local-reproduction
# WORLDCLAW_MODELS_DIR=~/.cache/worldclaw/models
# WORLDCLAW_WEB_DATA=/path/to/private/worldclaw-data
# WORLDCLAW_JOBS_DIR=/path/to/private/worldclaw-jobs

# Optional executable/checkpoint overrides. No access token belongs in this file.
# WORLDCLAW_BLENDER=/path/to/blender
# WORLDCLAW_SAM3_PYTHON=/path/to/sam3/python
# WORLDCLAW_SAM3_CHECKPOINT=/path/to/sam3.pt
# WORLDCLAW_SAM3D_PYTHON=/path/to/sam-3d-objects/python
# WORLDCLAW_SAM3D_CHECKPOINT=/path/to/pipeline.yaml
# WORLDCLAW_HUNYUAN_PYTHON=/path/to/hunyuan/python
# WORLDCLAW_HUNYUAN_MODEL=/path/to/Hunyuan3D-2.1
# WORLDCLAW_HUNYUAN_OMNI_MODEL=/path/to/Hunyuan3D-Omni
